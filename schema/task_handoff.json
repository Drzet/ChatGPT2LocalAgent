{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/chatgpt-to-local-agent/schema/v1/task_handoff.json",
  "title": "TaskHandoffPayload",
  "description": "Authoritative specification schema for handing off tasks from ChatGPT Web to local agents.",
  "type": "object",
  "required": [
    "schema_version",
    "context",
    "task",
    "constraints",
    "file_operations",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "SemVer schema version string (e.g. 1.0.0)"
    },
    "context": {
      "$ref": "#/definitions/ContextDefinition"
    },
    "task": {
      "$ref": "#/definitions/TaskDefinition"
    },
    "constraints": {
      "$ref": "#/definitions/ConstraintsDefinition"
    },
    "file_operations": {
      "type": "array",
      "description": "List of explicit target file operations requested",
      "items": {
        "$ref": "#/definitions/FileOperationItem"
      }
    },
    "verification": {
      "$ref": "#/definitions/VerificationDefinition"
    },
    "execution_options": {
      "$ref": "#/definitions/ExecutionOptionsDefinition"
    },
    "extensions": {
      "type": "object",
      "description": "Vendor-specific extension hooks"
    }
  },
  "definitions": {
    "ContextDefinition": {
      "type": "object",
      "required": [
        "session_id",
        "source",
        "user_intent",
        "decision_rationale",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique session UUID for this handoff transaction"
        },
        "conversation_id": {
          "type": "string",
          "description": "ChatGPT conversation UUID or URL slug"
        },
        "message_id": {
          "type": "string",
          "description": "Specific ChatGPT assistant message ID that initiated handoff"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 UTC timestamp of creation"
        },
        "source": {
          "type": "string",
          "enum": [
            "chatgpt_web_action",
            "browser_extension",
            "clipboard_sync",
            "mcp_gateway",
            "file_sync",
            "cli",
            "manual"
          ],
          "description": "Integration pathway used to dispatch the handoff"
        },
        "user_intent": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000,
          "description": "User high-level intent"
        },
        "decision_rationale": {
          "type": "string",
          "minLength": 5,
          "description": "Architectural and design decisions decided in ChatGPT"
        },
        "discussion_summary": {
          "type": "string",
          "description": "Concise summary of brainstorming discussion"
        },
        "discussion_history": {
          "type": "array",
          "description": "Excerpts or raw conversation messages for agent context",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant", "tool"]
              },
              "content": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "branch_or_context": {
          "type": "string",
          "description": "Target git branch or workspace context"
        },
        "custom_metadata": {
          "type": "object",
          "description": "Optional arbitrary key-value metadata"
        }
      }
    },
    "TaskDefinition": {
      "type": "object",
      "required": [
        "task_id",
        "title",
        "description",
        "category",
        "priority",
        "complexity"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{3,64}$",
          "description": "Unique task ID"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "description": "Human-readable task title"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Detailed markdown instructions"
        },
        "category": {
          "type": "string",
          "enum": [
            "feature",
            "bugfix",
            "refactor",
            "test",
            "documentation",
            "investigation",
            "migration",
            "chore",
            "security"
          ],
          "description": "Task engineering category"
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "default": "medium",
          "description": "Execution priority"
        },
        "complexity": {
          "type": "string",
          "enum": ["trivial", "small", "medium", "large", "epic"],
          "default": "medium",
          "description": "Estimated task complexity"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": "List of categorical tags"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite task IDs"
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated execution duration"
        }
      }
    },
    "ConstraintsDefinition": {
      "type": "object",
      "required": ["environment", "security_policy", "limits"],
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "object",
          "required": ["os", "runtime", "cwd"],
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string",
              "enum": ["mac", "linux", "windows", "any"]
            },
            "runtime": {
              "type": "string",
              "description": "Required runtime version (e.g. node>=20, python>=3.11)"
            },
            "cwd": {
              "type": "string",
              "description": "Target project working directory"
            },
            "env_vars": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Required non-secret environment variables"
            }
          }
        },
        "security_policy": {
          "type": "object",
          "required": [
            "execution_mode",
            "permitted_commands",
            "forbidden_commands",
            "allowed_file_paths",
            "forbidden_file_paths"
          ],
          "additionalProperties": false,
          "properties": {
            "execution_mode": {
              "type": "string",
              "enum": ["dry_run", "sandboxed", "interactive_approval", "autonomous"],
              "default": "sandboxed"
            },
            "permitted_commands": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Regex or glob patterns of whitelisted shell commands"
            },
            "forbidden_commands": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Regex patterns of blocked dangerous shell commands"
            },
            "allowed_file_paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for paths agent is allowed to access/modify"
            },
            "forbidden_file_paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Glob patterns for protected sensitive files"
            },
            "network_access": {
              "type": "string",
              "enum": ["none", "local_only", "full"],
              "default": "local_only"
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "max_execution_timeout_seconds",
            "max_iterations",
            "max_file_modifications"
          ],
          "additionalProperties": false,
          "properties": {
            "max_execution_timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "default": 600
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 30
            },
            "max_file_modifications": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 25
            },
            "max_token_budget": {
              "type": "integer",
              "minimum": 100
            }
          }
        },
        "deterministic_parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.0
            },
            "seed": {
              "type": "integer"
            },
            "strict_mode": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "FileOperationItem": {
      "type": "object",
      "required": ["path", "operation", "is_critical"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Target file relative or absolute path"
        },
        "operation": {
          "type": "string",
          "enum": ["create", "modify", "delete", "inspect", "rename", "patch"]
        },
        "target_path": {
          "type": "string",
          "description": "New path if renaming or moving"
        },
        "description": {
          "type": "string",
          "description": "Rationale for modifying this file"
        },
        "is_critical": {
          "type": "boolean",
          "default": true
        },
        "line_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_line", "end_line"],
            "additionalProperties": false,
            "properties": {
              "start_line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "content": {
          "type": "string",
          "description": "Full file content for create/overwrite"
        },
        "diff_patch": {
          "type": "string",
          "description": "Unified diff patch content"
        },
        "expected_sha256_before": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "expected_sha256_after": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "VerificationDefinition": {
      "type": "object",
      "required": ["automated_checks", "acceptance_statement"],
      "additionalProperties": false,
      "properties": {
        "automated_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type", "is_blocking"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 3
              },
              "type": {
                "type": "string",
                "enum": [
                  "command",
                  "file_exists",
                  "file_contains",
                  "file_matches_regex",
                  "http_check",
                  "test_suite"
                ]
              },
              "command": {
                "type": "string"
              },
              "target_path": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              },
              "expected_exit_code": {
                "type": "integer",
                "default": 0
              },
              "expected_stdout_contains": {
                "type": "array",
                "items": { "type": "string" }
              },
              "expected_stdout_matches": {
                "type": "string"
              },
              "forbidden_stderr_contains": {
                "type": "array",
                "items": { "type": "string" }
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800,
                "default": 60
              },
              "is_blocking": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "manual_verification_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptance_statement": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "ExecutionOptionsDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_rollback_on_failure": {
          "type": "boolean",
          "default": true
        },
        "notify_channel": {
          "type": "string",
          "enum": ["websocket", "webhook", "desktop_notification", "none"],
          "default": "websocket"
        },
        "create_git_branch": {
          "type": "string"
        }
      }
    }
  }
}
