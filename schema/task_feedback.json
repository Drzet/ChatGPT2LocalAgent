{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/chatgpt-to-local-agent/schema/v1/task_feedback.json",
  "title": "TaskFeedbackEvent",
  "description": "Bidirectional status update and execution feedback event sent from local bridge to ChatGPT Web.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "timestamp",
    "state",
    "progress",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "SemVer schema version string (e.g. 1.0.0)"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID for this feedback event"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{3,64}$",
      "description": "Correlation task identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of event generation"
    },
    "state": {
      "type": "string",
      "enum": [
        "received",
        "validating",
        "queued",
        "running",
        "waiting_confirmation",
        "waiting_user_input",
        "succeeded",
        "failed",
        "cancelled",
        "blocked"
      ],
      "description": "Current lifecycle state of task execution"
    },
    "progress": {
      "type": "object",
      "required": ["percent", "current_step", "total_steps", "completed_steps"],
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall task progress percentage (0-100)"
        },
        "current_step": {
          "type": "string",
          "description": "Description of the active execution phase or step"
        },
        "total_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Total planned execution steps"
        },
        "completed_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of steps completed"
        },
        "estimated_remaining_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated remaining seconds to completion"
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Concise human-readable status summary"
    },
    "logs": {
      "type": "array",
      "description": "Structured execution logs emitted during the step",
      "items": {
        "type": "object",
        "required": ["timestamp", "level", "source", "message"],
        "additionalProperties": false,
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"]
          },
          "source": {
            "type": "string",
            "enum": ["agent", "stdout", "stderr", "system", "verifier"]
          },
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "List of artifacts or modified files generated by execution",
      "items": {
        "type": "object",
        "required": ["path", "type", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["source_code", "patch", "test_report", "log", "documentation", "binary"]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "verification_results": {
      "type": "array",
      "description": "Results of automated assertion checks executed",
      "items": {
        "type": "object",
        "required": ["step_id", "name", "status", "duration_ms"],
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped", "timed_out"]
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_snippet": {
            "type": "string"
          },
          "stderr_snippet": {
            "type": "string"
          },
          "failure_reason": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "is_fatal"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ERR_SCHEMA_VALIDATION",
            "ERR_SECURITY_VIOLATION",
            "ERR_FORBIDDEN_PATH",
            "ERR_FORBIDDEN_COMMAND",
            "ERR_TIMEOUT",
            "ERR_VERIFICATION_FAILED",
            "ERR_DEPENDENCY_MISSING",
            "ERR_AGENT_CRASH",
            "ERR_UNAUTHORIZED",
            "ERR_FILE_CONFLICT",
            "ERR_USER_CANCELLED",
            "ERR_INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "stack_trace": {
          "type": "string"
        },
        "is_fatal": {
          "type": "boolean"
        },
        "remediation_suggestion": {
          "type": "string"
        }
      }
    },
    "user_prompt": {
      "type": "object",
      "required": ["prompt_id", "prompt_type", "message"],
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "type": "string"
        },
        "prompt_type": {
          "type": "string",
          "enum": ["confirm", "select", "text_input", "secret_input"]
        },
        "message": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default_value": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "custom_data": {
      "type": "object",
      "description": "Arbitrary vendor or transport telemetry metadata"
    }
  }
}
