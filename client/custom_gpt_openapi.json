{
  "openapi": "3.1.0",
  "info": {
    "title": "Local Agent Bridge API",
    "description": "Secure bridge daemon API connecting ChatGPT Web & Custom GPT Actions to a local developer agent environment (such as PI / local coding agent CLI, file system, and test runners).",
    "version": "1.0.0",
    "contact": {
      "name": "Local Agent Bridge System",
      "url": "https://github.com/local-agent-bridge"
    }
  },
  "servers": [
    {
      "url": "https://clay-gulp-anthology.ngrok-free.dev",
      "description": "Secure Tunnel Gateway (Cloudflare Tunnel / ngrok / Tailscale Funnel) proxying to local daemon"
    }
  ],
  "paths": {
    "/api/tasks": {
      "post": {
        "summary": "Submit a task handoff payload to local agent",
        "description": "Submits a structured task handoff payload containing context, objectives, target files, acceptance criteria, and verification commands to the local agent bridge daemon. Validates payload against security boundaries and JSON schema before queueing for execution.",
        "operationId": "submitTask",
        "security": [
          {
            "BearerAuth": ["DWjNukGvrtzIRfPBtYT7DM_oun_gm0ZhRmc_6URIQaI"]
          }
        ],
        "requestBody": {
          "description": "Structured task handoff payload specification",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskHandoffPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created and queued for execution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSubmissionResponse"
                }
              }
            }
          },
          "202": {
            "description": "Task accepted and waiting for user confirmation (HITL gate)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid task payload, schema validation failure, or security constraint violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer authentication token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Path traversal detected or unauthorized workspace root requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large - Request body exceeds maximum allowed size (5MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List recently submitted tasks",
        "description": "Retrieves a paginated list of tasks recorded in the local daemon task store with optional status filtering.",
        "operationId": "listTasks",
        "security": [
          {
            "BearerAuth": ["DWjNukGvrtzIRfPBtYT7DM_oun_gm0ZhRmc_6URIQaI"]
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter tasks by execution status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "received",
                "validating",
                "queued",
                "waiting_confirmation",
                "running",
                "succeeded",
                "failed",
                "cancelled",
                "timed_out"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tasks to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer authentication token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}": {
      "get": {
        "summary": "Get task status and execution results",
        "description": "Fetches detailed information about a specific task, including lifecycle state, timestamps, exit code, modified files, verification test results, and summary logs.",
        "operationId": "getTaskStatus",
        "security": [
          {
            "BearerAuth": ["DWjNukGvrtzIRfPBtYT7DM_oun_gm0ZhRmc_6URIQaI"]
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "description": "Unique identifier of the task",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer authentication token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/confirm": {
      "post": {
        "summary": "Confirm or reject a task awaiting approval",
        "description": "Provides human-in-the-loop (HITL) authorization for a task currently in 'waiting_confirmation' status, allowing execution to proceed or rejecting it.",
        "operationId": "confirmTask",
        "security": [
          {
            "BearerAuth": ["DWjNukGvrtzIRfPBtYT7DM_oun_gm0ZhRmc_6URIQaI"]
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "description": "Unique identifier of the task awaiting confirmation",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Confirmation decision payload",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskConfirmationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task confirmation processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskConfirmationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid confirmation request or task is not in WAITING_CONFIRMATION state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer authentication token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{task_id}/cancel": {
      "post": {
        "summary": "Cancel a queued or running task",
        "description": "Requests immediate cancellation and graceful termination of an active or queued agent task.",
        "operationId": "cancelTask",
        "security": [
          {
            "BearerAuth": ["DWjNukGvrtzIRfPBtYT7DM_oun_gm0ZhRmc_6URIQaI"]
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "description": "Unique identifier of the task to cancel",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task cancellation initiated or completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCancelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Task cannot be cancelled (e.g. already succeeded or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer authentication token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Daemon health probe",
        "description": "Returns operational health status, daemon version, active queue size, and uptime of the local bridge server.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Bridge daemon is healthy and accepting requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token",
        "description": "Shared high-entropy Bearer token validated via constant-time HMAC comparison on the local daemon"
      }
    },
    "schemas": {
      "TaskHandoffPayload": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "objective",
          "context",
          "tasks"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Protocol version of the handoff schema",
            "default": "1.0.0",
            "examples": ["1.0.0"]
          },
          "task_id": {
            "type": "string",
            "description": "Unique identifier for the task (UUID or unique slug)",
            "examples": ["task-20260901-001", "c7f9958e-d9a2-4a7b-a859-9943fcf3f7b2"]
          },
          "title": {
            "type": "string",
            "description": "Concise human-readable title of the task",
            "examples": ["Implement Bearer Token Authentication in Bridge Security Module"]
          },
          "objective": {
            "type": "string",
            "description": "Detailed high-level objective and rationale for the implementation work",
            "examples": ["Add constant-time HMAC bearer token authentication and origin validation to eliminate CSRF risks."]
          },
          "execution_mode": {
            "type": "string",
            "description": "Execution safety mode: 'standard' runs agent modifications; 'dry_run' computes planned changes without disk mutation.",
            "enum": [
              "standard",
              "dry_run"
            ],
            "default": "standard"
          },
          "require_confirmation": {
            "type": "boolean",
            "description": "If true, daemon pauses task at WAITING_CONFIRMATION gate awaiting explicit user approval before execution.",
            "default": false
          },
          "timeout_seconds": {
            "type": "integer",
            "description": "Maximum execution duration before SIGTERM/SIGKILL escalation",
            "default": 300,
            "minimum": 10,
            "maximum": 1800
          },
          "context": {
            "$ref": "#/components/schemas/TaskContext"
          },
          "target_files": {
            "type": "array",
            "description": "List of target file paths and modification intents",
            "items": {
              "$ref": "#/components/schemas/TargetFileSpec"
            }
          },
          "tasks": {
            "type": "array",
            "description": "Ordered sequence of concrete subtasks or implementation steps",
            "items": {
              "$ref": "#/components/schemas/SubtaskSpec"
            },
            "minItems": 1
          },
          "constraints": {
            "type": "array",
            "description": "Architectural, technical, or integrity constraints that the agent must strictly follow",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "Zero external Python dependencies (standard library only)",
                "All shell executions must use explicit argument vectors (shell=False)",
                "Enforce strict path containment within workspace root"
              ]
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "description": "Verifiable conditions required for task completion",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "Unit tests in test_security.py pass with 100% success rate",
                "Code coverage for bridge/security.py is >= 95%"
              ]
            ]
          },
          "verification_commands": {
            "type": "array",
            "description": "List of shell command vectors to run for automated verification",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "python3 run_tests.py",
                "python3 -m unittest discover tests"
              ]
            ]
          }
        }
      },
      "TaskContext": {
        "type": "object",
        "required": [
          "workspace_root"
        ],
        "properties": {
          "workspace_root": {
            "type": "string",
            "description": "Target local filesystem path for the project workspace",
            "examples": ["/Users/mengma/teamwork_projects/chatgpt_to_local_agent_research"]
          },
          "repo_name": {
            "type": "string",
            "description": "Repository or project name",
            "examples": ["chatgpt_to_local_agent_research"]
          },
          "branch": {
            "type": "string",
            "description": "Active git branch name",
            "examples": ["main"]
          },
          "environment_variables": {
            "type": "object",
            "description": "Safe environment variables to pass to the agent process",
            "additionalProperties": {
              "type": "string"
            }
          },
          "relevant_context_files": {
            "type": "array",
            "description": "Paths to existing reference files the agent should inspect before coding",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TargetFileSpec": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative file path within workspace_root",
            "examples": ["bridge/security.py"]
          },
          "action": {
            "type": "string",
            "description": "Intended filesystem modification type",
            "enum": [
              "create",
              "modify",
              "delete",
              "inspect"
            ],
            "default": "modify"
          },
          "description": {
            "type": "string",
            "description": "Specific modifications or role of this file in the task",
            "examples": ["Implements HMAC token check and path jail validation"]
          }
        }
      },
      "SubtaskSpec": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier for the subtask",
            "examples": ["step-1", "step-auth-check"]
          },
          "title": {
            "type": "string",
            "description": "Short summary of the subtask",
            "examples": ["Add Bearer token validator"]
          },
          "description": {
            "type": "string",
            "description": "Detailed execution instructions for this step",
            "examples": ["Implement verify_token function using hmac.compare_digest."]
          },
          "dependencies": {
            "type": "array",
            "description": "IDs of prerequisite subtasks",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TaskSubmissionResponse": {
        "type": "object",
        "required": [
          "task_id",
          "status",
          "created_at",
          "message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Unique identifier assigned to the task",
            "examples": ["task-20260901-001"]
          },
          "status": {
            "type": "string",
            "description": "Initial task status in the lifecycle engine",
            "enum": [
              "received",
              "queued",
              "waiting_confirmation"
            ],
            "examples": ["queued"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of task ingestion",
            "examples": ["2026-09-01T04:45:00Z"]
          },
          "message": {
            "type": "string",
            "description": "Human-readable status summary message",
            "examples": ["Task accepted and enqueued for local execution."]
          },
          "status_url": {
            "type": "string",
            "description": "REST endpoint URL to query task status and execution telemetry",
            "examples": ["/api/tasks/task-20260901-001"]
          },
          "events_url": {
            "type": "string",
            "description": "Server-Sent Events endpoint URL to stream real-time logs",
            "examples": ["/api/tasks/task-20260901-001/events"]
          }
        }
      },
      "TaskDetailResponse": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "status",
          "created_at"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Unique task identifier",
            "examples": ["task-20260901-001"]
          },
          "title": {
            "type": "string",
            "description": "Title of the task",
            "examples": ["Implement Bearer Token Authentication"]
          },
          "status": {
            "type": "string",
            "description": "Current lifecycle status",
            "enum": [
              "received",
              "validating",
              "queued",
              "waiting_confirmation",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out"
            ],
            "examples": ["succeeded"]
          },
          "execution_mode": {
            "type": "string",
            "enum": ["standard", "dry_run"],
            "examples": ["standard"]
          },
          "workspace_root": {
            "type": "string",
            "examples": ["/Users/mengma/teamwork_projects/chatgpt_to_local_agent_research"]
          },
          "exit_code": {
            "type": "integer",
            "nullable": true,
            "description": "Process exit code (0 for success, non-zero for error)",
            "examples": [0]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "examples": ["2026-09-01T04:45:00Z"]
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "examples": ["2026-09-01T04:45:02Z"]
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "examples": ["2026-09-01T04:45:15Z"]
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "description": "Total execution duration in seconds",
            "examples": [13.25]
          },
          "error_message": {
            "type": "string",
            "nullable": true,
            "description": "Error details if task failed or timed out",
            "examples": [null]
          },
          "summary": {
            "type": "string",
            "nullable": true,
            "description": "Markdown summary of completed changes and test outcomes",
            "examples": ["Successfully implemented HMAC bearer auth. 8 unit tests passed."]
          },
          "modified_files": {
            "type": "array",
            "description": "List of filesystem paths created or modified during execution",
            "items": {
              "type": "string"
            },
            "examples": [["bridge/security.py", "tests/test_security.py"]]
          },
          "verification_results": {
            "type": "array",
            "description": "Outcomes of executed verification test commands",
            "items": {
              "$ref": "#/components/schemas/VerificationResultSpec"
            }
          },
          "feedback": {
            "$ref": "#/components/schemas/TaskFeedbackSpec"
          }
        }
      },
      "VerificationResultSpec": {
        "type": "object",
        "required": [
          "command",
          "exit_code",
          "passed"
        ],
        "properties": {
          "command": {
            "type": "string",
            "examples": ["python3 run_tests.py"]
          },
          "exit_code": {
            "type": "integer",
            "examples": [0]
          },
          "passed": {
            "type": "boolean",
            "examples": [true]
          },
          "output_snippet": {
            "type": "string",
            "examples": ["Ran 24 tests in 0.45s. OK (Coverage: 94.2%)"]
          }
        }
      },
      "TaskFeedbackSpec": {
        "type": "object",
        "properties": {
          "executor_type": {
            "type": "string",
            "examples": ["pi", "mock"]
          },
          "stdout_bytes": {
            "type": "integer",
            "examples": [4096]
          },
          "stderr_bytes": {
            "type": "integer",
            "examples": [0]
          },
          "stdout_preview": {
            "type": "string",
            "examples": ["Loaded tools. Modified files. Tests passed."]
          },
          "stderr_preview": {
            "type": "string",
            "examples": [""]
          }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "required": [
          "tasks",
          "total_count",
          "limit",
          "offset"
        ],
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskDetailResponse"
            }
          },
          "total_count": {
            "type": "integer",
            "examples": [42]
          },
          "limit": {
            "type": "integer",
            "examples": [10]
          },
          "offset": {
            "type": "integer",
            "examples": [0]
          }
        }
      },
      "TaskConfirmationRequest": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "description": "User approval decision for the gated task",
            "examples": ["approve"]
          },
          "reason": {
            "type": "string",
            "description": "Optional notes or rejection rationale",
            "examples": ["Approved plan after reviewing modified file list."]
          }
        }
      },
      "TaskConfirmationResponse": {
        "type": "object",
        "required": [
          "task_id",
          "status",
          "message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "examples": ["task-20260901-001"]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "cancelled"
            ],
            "examples": ["queued"]
          },
          "message": {
            "type": "string",
            "examples": ["Task approved and transitioned to execution queue."]
          }
        }
      },
      "TaskCancelResponse": {
        "type": "object",
        "required": [
          "task_id",
          "status",
          "message"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "examples": ["task-20260901-001"]
          },
          "status": {
            "type": "string",
            "enum": [
              "cancelled"
            ],
            "examples": ["cancelled"]
          },
          "message": {
            "type": "string",
            "examples": ["Task cancelled successfully."]
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version",
          "uptime_seconds",
          "active_workers",
          "queue_depth"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ],
            "examples": ["healthy"]
          },
          "version": {
